# Base URL of the API, including /api.
EXPO_PUBLIC_API_URL=http://localhost:7777/api

# Web OAuth client ID from Google Cloud Console. Native sign-in uses it to
# mint the ID token that POST /user/google/mobile verifies.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=000000000000-xxxxxxxx.apps.googleusercontent.com

# Stripe publishable key (pk_test_... locally, pk_live_... in production).
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxx
